# PlummyKnowledge — environment variables (Instance Settings, ADR-006).
#
# Copy to .env only if you need to override defaults: `docker compose up --build` works without it.
# Never commit .env. This file must not contain real credentials.
#
# Secrets can also be passed as files (Docker secrets): DATABASE_URL_FILE, REDIS_URL_FILE, SECRET_KEY_FILE.
# Setting both NAME and NAME_FILE is a configuration error.

# --- Application -----------------------------------------------------------------------------------------
# development | test | production. Unset = production (strictest validation).
APP_ENV=development
# Must be false in production. When true, unhandled errors return tracebacks (local debugging only).
APP_DEBUG=false
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Required in production, at least 32 characters. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Empty in development = an ephemeral key is generated on each start.
SECRET_KEY=
# Comma-separated list of allowed browser origins for cross-origin API calls. Empty = same-origin only
# (the default: the frontend reaches the API through the Vite proxy / Nginx). '*' is rejected.
CORS_ORIGINS=
# Public URL of the web UI (scheme://host[:port]). Its origin is trusted for state-changing requests
# (Origin/CSRF check, ADR-013). Required in production and must be https there. Dev default:
# PUBLIC_URL=http://localhost:5173
# Secure session cookie (`__Host-pk_session`). true by default and required in production; the dev compose
# sets false because http://localhost has no TLS.
# SESSION_COOKIE_SECURE=false
# Session lifetimes: seconds or ISO 8601. Idle 5 min..30 days (default 24 h), absolute 1 h..90 days (7 days).
# SESSION_IDLE_TTL=86400
# SESSION_ABSOLUTE_TTL=604800

# --- First-run setup (ADR-006) -------------------------------------------------------------------------
# web = setup wizard with the one-time token from BOOTSTRAP_DIR/setup-token (default);
# cli_only = web setup disabled, create the first administrator with `python -m plummy.cli admin create`.
# SETUP_MODE=web
# Directory of the setup token file (inside the container). Default: /var/lib/plummy/bootstrap
# BOOTSTRAP_DIR=/var/lib/plummy/bootstrap
# Lifetime of the setup token: 10 min..30 days (default 24 h).
# BOOTSTRAP_TOKEN_TTL=86400

# --- Stored secrets (ADR-016) --------------------------------------------------------------------------
# JSON key ring outside the database: {"primary": "<key id>", "keys": {"<key id>": "<base64url 32 bytes>"}}.
# Required in production (mount it as a file, mode 0400, and back it up separately from the database).
# The dev compose sets /var/lib/plummy/secrets/keyring.json; `migrate` creates it on first start
# (python -m plummy.cli secrets init-keyring). New key: python -m plummy.cli secrets generate-key.
# SECRETS_KEYRING_FILE=/var/lib/plummy/secrets/keyring.json

# --- Document storage (ARCHITECTURE.md 8.5) --------------------------------------------------------------
# Originals and quarantine on the local filesystem (S3-compatible storage comes with the production profile).
# The directory must exist and be writable only by the application user (mode 0700); the dev compose mounts a
# volume. Quarantined files older than QUARANTINE_TTL (seconds or ISO 8601, 10 minutes to 7 days) are removed.
# STORAGE_BACKEND=local
# STORAGE_PATH=/var/lib/plummy/storage
# QUARANTINE_TTL=86400
# Largest upload in bytes (default 50 MiB), checked while the file streams in. Keep the reverse proxy's body
# limit slightly above it.
# UPLOAD_MAX_BYTES=52428800
# Hard limit of one chat answer, retrieval included (ADR-019), 10-600 seconds.
# CHAT_GENERATION_TIMEOUT_SECONDS=120

# --- Outbound network (ADR-007) ------------------------------------------------------------------------
# TOML instance configuration with the network allowlist. Unset = empty allowlist: only public https
# endpoints are reachable; internal addresses (e.g. a local Ollama) need an explicit entry:
#   [[network.allowlist]]
#   name           = "local-ollama"
#   url            = "http://ollama:11434"
#   purposes       = ["llm", "embedding"]
#   provider_types = ["ollama"]
#   allowed_cidrs  = ["172.30.10.0/24"]
# HTTP(S)_PROXY variables are ignored by the backend. Changes take effect after restarting API and worker.
# CONFIG_FILE=/etc/plummy/plummy.toml

# --- External sources (OAuth connectors) -----------------------------------------------------------------
# Optional; give them to backend and worker together with PUBLIC_URL. Prefer the *_FILE form for the secret.
# Redirect URI to register at the provider: <PUBLIC_URL>/api/v1/data-sources/oauth/callback.
# Google Drive (ADR-020, DEPLOYMENT.md 7.4): both values or none.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET_FILE=/run/secrets/google_oauth_client_secret
# Microsoft 365 (ADR-021, DEPLOYMENT.md 7.5): all three or none. The tenant is a GUID or a domain;
# common / organizations / consumers are rejected.
# MICROSOFT_OAUTH_TENANT_ID=
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET_FILE=/run/secrets/microsoft_oauth_client_secret

# Swagger UI at /api/v1/docs (loads JS/CSS from a public CDN). Empty = enabled except in production.
# /api/v1/openapi.json is always available.
API_DOCS_ENABLED=

# --- PostgreSQL (dev compose, ADR-011) -------------------------------------------------------------------
# Applied only when the postgres-data volume is created; to change them later, recreate the volume
# (docker compose down -v — deletes local development data).
#
# Password of the bootstrap superuser `postgres`. Used only inside the postgres container by
# deploy/postgres/initdb to create the application role, its database and the extensions; never passed to
# migrate/backend. Default: postgres_dev_password.
# POSTGRES_PASSWORD=
#
# Application role (no SUPERUSER) and its database. migrate and backend connect with these; compose builds
# DATABASE_URL from them. Defaults: plummy / plummy_dev_password / plummy.
# PLUMMY_DB_USER=plummy
# PLUMMY_DB_PASSWORD=
# PLUMMY_DB_NAME=plummy

# --- Backend connection strings (when running the backend outside compose) --------------------------------
# DATABASE_URL must use the asyncpg driver: postgresql+asyncpg://USER:PASSWORD@HOST:5432/DB
# DATABASE_URL=postgresql+asyncpg://plummy:<password>@localhost:5432/plummy
# REDIS_URL=redis://localhost:6379/0
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5

# --- Worker (dev compose) -----------------------------------------------------------------------------------
# Celery worker processes (`--concurrency`); the broker and result backend are REDIS_URL.
# WORKER_CONCURRENCY=2
# Memory limit of the worker-ingestion container (Docling parses one document at a time).
# INGESTION_MEMORY_LIMIT=4g

# --- Frontend (public, embedded into the JS bundle — never put secrets here) -------------------------------
# VITE_API_BASE_URL=/api/v1
