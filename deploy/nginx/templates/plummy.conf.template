# Rendered at start by the image's envsubst step into /tmp/nginx-conf (only ${PLUMMY_*} variables are
# substituted, NGINX_ENVSUBST_FILTER). Values come from compose.prod.yaml.

upstream plummy_api {
  server backend:8000;
  keepalive 16;
}

# Plain HTTP: only the redirect to HTTPS.
server {
  listen 8080 default_server;
  server_name _;
  # Container healthcheck (compose.prod.yaml); answers on the plain port only, without redirect.
  location = /nginx-health {
    access_log off;
    default_type text/plain;
    return 200 "ok";
  }
  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 8443 ssl default_server;
  http2 on;
  server_name ${PLUMMY_SERVER_NAME};

  ssl_certificate /run/secrets/tls_fullchain.pem;
  ssl_certificate_key /run/secrets/tls_privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:plummy_tls:10m;
  ssl_session_timeout 1d;
  ssl_session_tickets off;

  root /usr/share/nginx/html;
  include /etc/nginx/plummy/security-headers.conf;

  # Uploads go to the API as they arrive (no buffering on disk); the API enforces UPLOAD_MAX_BYTES itself.
  client_max_body_size ${PLUMMY_CLIENT_MAX_BODY_SIZE};

  location /api/ {
    include /etc/nginx/plummy/proxy-api.conf;
    proxy_request_buffering off;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
  }

  # Answer streaming (SSE, ADR-019): no buffering, a read timeout longer than CHAT_GENERATION_TIMEOUT_SECONDS.
  location = /api/v1/chat/stream {
    include /etc/nginx/plummy/proxy-api.conf;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout ${PLUMMY_STREAM_READ_TIMEOUT};
    proxy_send_timeout 60s;
  }

  # Hashed bundle files: cached for a year.
  location /assets/ {
    include /etc/nginx/plummy/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  # SPA: every other path is the application shell, never cached (a new release is picked up at once).
  location / {
    include /etc/nginx/plummy/security-headers.conf;
    add_header Cache-Control "no-cache" always;
    try_files $uri /index.html;
  }
}
