# Environment of the production stack (compose.prod.yaml). Copy to deploy/prod/.env and adjust:
#   docker compose -f compose.prod.yaml --env-file deploy/prod/.env --profile s3 up -d --build
# Secrets never go here: they are files in deploy/prod/secrets/ (deploy/prod/init-secrets.sh).

# Public origin of the UI (https only); state-changing requests from other origins are rejected.
PUBLIC_URL=https://knowledge.example.com
PLUMMY_SERVER_NAME=knowledge.example.com

# Published ports of Nginx (the only published service).
PLUMMY_BIND_ADDRESS=0.0.0.0
PLUMMY_HTTP_PORT=80
PLUMMY_HTTPS_PORT=443
# PLUMMY_TLS_CERT=./deploy/prod/certs/fullchain.pem
# PLUMMY_TLS_KEY=./deploy/prod/certs/privkey.pem

# Document storage (ADR-022). With the bundled server (profile s3) keep the defaults; for an external S3 set
# the https endpoint and bucket, put its keys into secrets/s3_access_key_id and secrets/s3_secret_access_key
# and start without --profile s3.
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://s3:7070
S3_BUCKET=plummy-documents
S3_REGION=us-east-1
S3_PREFIX=

# Uploads (bytes) and Nginx's body limit (a little higher).
UPLOAD_MAX_BYTES=52428800
PLUMMY_CLIENT_MAX_BODY_SIZE=60m
# Answer generation timeout; Nginx's stream timeout must be longer.
CHAT_GENERATION_TIMEOUT_SECONDS=120
PLUMMY_STREAM_READ_TIMEOUT=180s

LOG_LEVEL=INFO
WORKER_CONCURRENCY=2

# Connectors (client IDs here, client secrets as files: DEPLOYMENT.md).
GOOGLE_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_TENANT_ID=

# Resource limits (defaults in compose.prod.yaml).
# BACKEND_MEMORY_LIMIT=1g
# WORKER_MEMORY_LIMIT=1g
# INGESTION_MEMORY_LIMIT=4g
# POSTGRES_MEMORY_LIMIT=2g
