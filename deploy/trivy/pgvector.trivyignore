# Linux-PAM pam_namespace directory traversal: the container has no login, su or PAM-authenticated service;
# PostgreSQL authenticates with scram-sha-256 (the image entrypoint with a password file), not PAM.
CVE-2025-6020 exp:2027-02-28

# zstd information disclosure via an uninitialized buffer when compressing, published 2026-11-24 after the
# image was built: the stack does not compress with zstd (wal_compression is off, backup.sh writes pg_dump's
# default gzip). Short expiry: the next pgvector build of the tag includes the Debian fix.
CVE-2026-124851 exp:2026-12-31
