#!/bin/sh
# Automatic version bump on every commit (docs/adr/0009-automatic-versioning.md).
# Skip once: PLUMMY_SKIP_VERSION_BUMP=1 git commit ...
root=$(git rev-parse --show-toplevel) || exit 1
if ! command -v python3 >/dev/null 2>&1; then
  echo "pre-commit: python3 is required for automatic versioning (scripts/version.py)" >&2
  exit 1
fi
exec python3 "$root/scripts/version.py" bump
